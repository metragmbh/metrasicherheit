---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import settings from '../data/cms/settings.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { 
  title = settings.seo.default_title,
  description = settings.seo.default_description,
  ogImage = settings.seo.og_image,
  canonical = Astro.url.pathname,
  noindex = false
} = Astro.props;

const siteUrl = settings.seo.site_url;
const fullCanonical = `${siteUrl}${canonical}`;
const LOGO_PATH = '/images/logoneu.png';

// Schema.org JSON-LD
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.company.name,
  url: siteUrl,
  logo: `${siteUrl}${LOGO_PATH}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.company.street,
    addressLocality: settings.company.city,
    postalCode: settings.company.zip,
    addressCountry: 'DE'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+49${settings.company.phone_raw}`,
    contactType: 'customer service',
    email: settings.company.email
  },
  sameAs: []
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: settings.company.name,
  image: `${siteUrl}${ogImage}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.company.street,
    addressLocality: settings.company.city,
    postalCode: settings.company.zip,
    addressCountry: 'DE'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '50.9484',
    longitude: '6.9525'
  },
  url: siteUrl,
  telephone: `+49${settings.company.phone_raw}`,
  priceRange: '€€',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59'
  }
};
---

<!DOCTYPE html>
<html lang="de-DE" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={settings.company.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={fullCanonical} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Preconnect für Performance -->
    <link rel="preconnect" href="https://api.web3forms.com" />
    
    <!-- Preload Fonts -->
    <link rel="preload" href="/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="700" />
    <meta property="og:image:height" content="394" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="METRA Sicherheitsdienste" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    
    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#00002e" />
    
    <!-- Critical CSS Inline für Above-the-fold -->
    <style is:inline>
      /* Critical CSS */
      body {
        background-color: #00002e;
        color: #ffffff;
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      
      /* Font Display Swap */
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter-regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  
  <body class="min-h-screen flex flex-col">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-accent text-background px-4 py-2 rounded font-medium z-50"
    >
      Zum Hauptinhalt springen
    </a>
    
    <slot />
    
    <CookieBanner />
  </body>
</html>
