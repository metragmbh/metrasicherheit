---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import settings from '../data/cms/settings.json';
import impressum from '../data/cms/impressum.json';

const company = settings.company;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: settings.seo.site_url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Impressum',
      item: `${settings.seo.site_url}/impressum`,
    },
  ],
};
---

<Layout 
  title={impressum.seo.title}
  description={impressum.seo.description}
  canonical="/impressum"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  
  <Header />
  <MobileMenu />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 overflow-hidden" aria-labelledby="imprint-title">
      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-5 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-secondary mb-6">
            <li><a href="/" class="hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">Startseite</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-accent">Impressum</li>
          </ol>
        </nav>
        
        <p class="text-accent font-semibold tracking-wider text-sm mb-4">{impressum.hero.label}</p>
        <h1 id="imprint-title" class="text-4xl md:text-5xl font-bold text-white leading-tight">
          {impressum.hero.title}
        </h1>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-12 md:py-20 bg-background/20" aria-label="Impressumsangaben">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-invert max-w-none">
          
          <!-- Angaben gemäß § 5 TMG -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-6">{impressum.content.company_section.title}</h2>
            
            <div class="bg-white/5 border border-white/5 rounded-xl p-6 md:p-8">
              <address class="not-italic space-y-4 text-secondary">
                <div>
                  <p class="text-white font-semibold text-lg">{company.name}</p>
                  <p>{company.street}</p>
                  <p>{company.zip} {company.city}</p>
                  <p>{company.country}</p>
                </div>
                
                <div class="pt-4 border-t border-white/10">
                  <p><span class="text-white">{impressum.content.company_section.label_owner}</span> {company.owner}</p>
                  <p><span class="text-white">{impressum.content.company_section.label_registration}</span> {company.registry_court}, {company.registration}</p>
                  <p><span class="text-white">{impressum.content.company_section.label_vat}</span> {company.vat_id}</p>
                </div>
                
                <div class="pt-4 border-t border-white/10">
                  <p>
                    <span class="text-white">{impressum.content.company_section.label_phone}</span>{' '}
                    <a href={`tel:${company.phone_raw}`} class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">
                      {company.phone_display}
                    </a>
                  </p>
                  <p>
                    <span class="text-white">{impressum.content.company_section.label_email}</span>{' '}
                    <a href={`mailto:${company.email}`} class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">
                      {company.email}
                    </a>
                  </p>
                  <p>
                    <span class="text-white">{impressum.content.company_section.label_web}</span>{' '}
                    <a href={`https://${company.web}`} class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">
                      {company.web}
                    </a>
                  </p>
                </div>
              </address>
            </div>
          </article>

          <!-- Redaktionell Verantwortlicher -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{impressum.content.responsible_section.title}</h2>
            <p class="text-secondary">
              {company.owner}<br />
              {company.name}<br />
              {company.street}<br />
              {company.zip} {company.city}
            </p>
          </article>

          <!-- EU-Streitschlichtung -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{impressum.content.eu_odr_section.title}</h2>
            <p class="text-secondary mb-4">
              {impressum.content.eu_odr_section.text}{' '}
              <a 
                href={impressum.content.eu_odr_section.link_text}
                target="_blank" 
                rel="noopener noreferrer"
                class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
              >
                {impressum.content.eu_odr_section.link_text}
              </a>
            </p>
            <p class="text-secondary">
              {impressum.content.eu_odr_section.hint_text}
            </p>
          </article>

          <!-- Verbraucherstreitbeilegung -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{impressum.content.dispute_section.title}</h2>
            <p class="text-secondary">
              {impressum.content.dispute_section.text}
            </p>
          </article>

          <!-- Haftung für Inhalte -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{impressum.content.content_liability_section.title}</h2>
            <p class="text-secondary mb-4">
              {impressum.content.content_liability_section.text_1}
            </p>
            <p class="text-secondary mb-4">
              {impressum.content.content_liability_section.text_2}
            </p>
          </article>

          <!-- Haftung für Links -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{impressum.content.link_liability_section.title}</h2>
            <p class="text-secondary mb-4">
              {impressum.content.link_liability_section.text_1}
            </p>
            <p class="text-secondary">
              {impressum.content.link_liability_section.text_2}
            </p>
          </article>

          <!-- Urheberrecht -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{impressum.content.copyright_section.title}</h2>
            <p class="text-secondary mb-4">
              {impressum.content.copyright_section.text_1}
            </p>
            <p class="text-secondary">
              {impressum.content.copyright_section.text_2}
            </p>
          </article>

        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</Layout>
