---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import settings from '../data/cms/settings.json';
import datenschutz from '../data/cms/datenschutz.json';

const company = settings.company;

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: settings.seo.site_url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Datenschutz',
      item: `${settings.seo.site_url}/datenschutz`,
    },
  ],
};
---

<Layout 
  title={datenschutz.seo.title}
  description={datenschutz.seo.description}
  canonical="/datenschutz"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  
  <Header />
  <MobileMenu />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 overflow-hidden" aria-labelledby="privacy-title">
      <div class="absolute inset-0 opacity-5" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-5 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-secondary mb-6">
            <li><a href="/" class="hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">Startseite</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-accent">Datenschutz</li>
          </ol>
        </nav>
        
        <p class="text-accent font-semibold tracking-wider text-sm mb-4">{datenschutz.hero.label}</p>
        <h1 id="privacy-title" class="text-4xl md:text-5xl font-bold text-white leading-tight break-words">
          {datenschutz.hero.title}
        </h1>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-12 md:py-20 bg-background/20" aria-label="Datenschutzinformationen">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-invert max-w-none">
          
          <!-- Einleitung -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_1.title}</h2>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_1.general_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_1.general_text}
            </p>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_1.collection_title}</h3>
            <p class="text-secondary mb-4">
              <strong class="text-white">{datenschutz.section_1.responsible_question}</strong>
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_1.responsible_answer}
            </p>
            
            <p class="text-secondary mb-4">
              <strong class="text-white">{datenschutz.section_1.how_question}</strong>
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_1.how_answer_1}
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_1.how_answer_2}
            </p>
            
            <p class="text-secondary mb-4">
              <strong class="text-white">{datenschutz.section_1.why_question}</strong>
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_1.why_answer}
            </p>
            
            <p class="text-secondary mb-4">
              <strong class="text-white">{datenschutz.section_1.rights_question}</strong>
            </p>
            <p class="text-secondary">
              {datenschutz.section_1.rights_answer}
            </p>
          </article>

          <!-- Hosting -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_2.title}</h2>
            <p class="text-secondary mb-4">
              {datenschutz.section_2.intro}
            </p>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_2.provider_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_2.provider_text}{' '}
              <a 
                href={datenschutz.section_2.privacy_link}
                target="_blank" 
                rel="noopener noreferrer"
                class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
              >
                {datenschutz.section_2.privacy_link}
              </a>
            </p>
            <p class="text-secondary">
              {datenschutz.section_2.legal_text}
            </p>
          </article>

          <!-- Verantwortliche -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_3.title}</h2>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_3.privacy_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_3.privacy_text_1}
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_3.privacy_text_2}
            </p>
            <p class="text-secondary">
              {datenschutz.section_3.privacy_text_3}
            </p>
            
            <h3 class="text-xl font-semibold text-white mb-3 mt-8">{datenschutz.section_3.controller_title}</h3>
            <div class="bg-white/5 border border-white/5 rounded-xl p-6">
              <address class="not-italic text-secondary space-y-1">
                <p class="text-white font-semibold">{company.name}</p>
                <p>Geschäftsführer: {company.owner}</p>
                <p>{company.street}</p>
                <p>{company.zip} {company.city}</p>
                <p class="mt-4">
                  <span class="text-white">Telefon:</span>{' '}
                  <a href={`tel:${company.phone_raw}`} class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">
                    {company.phone_display}
                  </a>
                </p>
                <p>
                  <span class="text-white">E-Mail:</span>{' '}
                  <a href={`mailto:${company.email}`} class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded">
                    {company.email}
                  </a>
                </p>
              </address>
            </div>
            <p class="text-secondary mt-4">
              {datenschutz.section_3.controller_explanation}
            </p>
            
            <h3 class="text-xl font-semibold text-white mb-3 mt-8">{datenschutz.section_3.storage_title}</h3>
            <p class="text-secondary">
              {datenschutz.section_3.storage_text}
            </p>
            
            <h3 class="text-xl font-semibold text-white mb-3 mt-8">{datenschutz.section_3.legal_basis_title}</h3>
            <p class="text-secondary">
              {datenschutz.section_3.legal_basis_text}
            </p>
          </article>

          <!-- Kontaktformular -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_4.title}</h2>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_4.form_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_4.form_text_1}
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_4.form_text_2}
            </p>
            <p class="text-secondary">
              {datenschutz.section_4.form_text_3}
            </p>
            
            <h3 class="text-xl font-semibold text-white mb-3 mt-8">{datenschutz.section_4.email_request_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_4.email_request_text_1}
            </p>
            <p class="text-secondary">
              {datenschutz.section_4.email_request_text_2}
            </p>
          </article>

          <!-- Plugins & Tools -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_5.title}</h2>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_5.web3forms_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_5.web3forms_text_1}
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_5.web3forms_text_2}{' '}
              <a 
                href={datenschutz.section_5.web3forms_privacy_link}
                target="_blank" 
                rel="noopener noreferrer"
                class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
              >
                {datenschutz.section_5.web3forms_privacy_link}
              </a>
            </p>
            <p class="text-secondary">
              {datenschutz.section_5.web3forms_legal}
            </p>
          </article>

          <!-- Ihre Rechte -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_6.title}</h2>
            
            <p class="text-secondary mb-4">
              {datenschutz.section_6.intro}
            </p>
            
            <ul class="space-y-3 text-secondary mb-6">
              {datenschutz.section_6.rights.map((right) => (
                <li class="flex items-start gap-3">
                  <span class="text-accent font-bold">•</span>
                  <span><strong class="text-white">{right.title}</strong> {right.description}</span>
                </li>
              ))}
            </ul>
            
            <h3 class="text-xl font-semibold text-white mb-3">{datenschutz.section_6.complaint_title}</h3>
            <p class="text-secondary mb-4">
              {datenschutz.section_6.complaint_text_1}
            </p>
            <p class="text-secondary">
              {datenschutz.section_6.complaint_text_2}{' '}
              <a 
                href={datenschutz.section_6.bfdi_link}
                target="_blank" 
                rel="noopener noreferrer"
                class="text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
              >
                {datenschutz.section_6.bfdi_link}
              </a>
            </p>
          </article>

          <!-- Cookies -->
          <article class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.section_7.title}</h2>
            <p class="text-secondary mb-4">
              {datenschutz.section_7.text_1}
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_7.text_2}
            </p>
            <p class="text-secondary mb-4">
              {datenschutz.section_7.text_3}
            </p>
            <p class="text-secondary">
              {datenschutz.section_7.text_4}
            </p>
          </article>

          <!-- Stand -->
          <article>
            <h2 class="text-2xl font-bold text-white mb-4">{datenschutz.last_updated.title}</h2>
            <p class="text-secondary">
              {datenschutz.last_updated.text}
            </p>
          </article>

        </div>
      </div>
    </section>
  </main>
  
  <Footer />
  <WhatsAppButton />
</Layout>
